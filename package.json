{
    "name": "nova-monorepo",
    "private": true,
    "scripts": {
        "docs:dev": "pnpm -F nova-docs run dev",
        "docs:build": "pnpm -F nova-docs run build",
        "prepare": "husky",
        "lint": "oxlint -c oxlint.json",
        "lint:fix": "oxlint --fix",
        "format": "oxfmt",
        "changeset": "changeset",
        "version": "changeset version",
        "release": "changeset publish"
    },
    "lint-staged": {
        "*.{js,ts,mjs,cjs}": [
            "oxfmt",
            "oxlint --fix"
        ]
    },
    "devDependencies": {
        "@changesets/cli": "^2.31.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.4",
        "oxfmt": "^0.49.0",
        "oxlint": "^1.64.0"
    }
}