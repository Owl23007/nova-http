{
  "name": "nova-monorepo",
  "private": true,
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "check:release": "node scripts/check-release-sync.mjs",
    "check:templates": "pnpm -F nova-http exec tsc -p cli/templates/minimal/tsconfig.json --noEmit && pnpm -F nova-http exec tsc -p cli/templates/api/tsconfig.json --noEmit",
    "check:cli": "node scripts/check-cli.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check .",
    "lint": "oxlint -c oxlint.json",
    "lint:fix": "oxlint --fix",
    "docs:dev": "pnpm -F nova-docs run dev",
    "docs:build": "pnpm -F nova-docs run build",
    "prepare": "husky",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs}": [
      "oxfmt",
      "oxlint --fix"
    ],
    "*.{json,yml,yaml,md}": "oxfmt"
  },
  "packageManager": "pnpm@10.20.0"
}
