{
  "name": "@nova-http/benchmarks",
  "private": true,
  "type": "module",
  "scripts": {
    "bench": "node runner/cli.js",
    "test": "pnpm --filter nova-http build && vitest run",
    "typecheck": "tsc --noEmit",
    "archive:check": "node report/archive-cli.js",
    "bench:parser": "node suites/parser/llhttp.cjs",
    "bench:parser:native": "node suites/parser/node-native.cjs",
    "bench:production": "node suites/production/src/app/server.js",
    "bench:production:stress": "node suites/production/src/runner/stress-test.js",
    "bench:stream": "node suites/production/streaming.cjs"
  },
  "dependencies": {
    "autocannon": "8.0.0",
    "fastify": "5.12.5",
    "llhttp-wasm": "1.0.3",
    "nova-http": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
