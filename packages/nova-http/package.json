{
  "name": "nova-http",
  "version": "0.2.0",
  "description": "零依赖、高性能、全链路可控的 Node.js HTTP 框架",
  "keywords": [
    "framework",
    "http",
    "middleware",
    "net",
    "router",
    "server"
  ],
  "homepage": "https://github.com/Owl23007/nova-http#readme",
  "bugs": {
    "url": "https://github.com/Owl23007/nova-http/issues"
  },
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Owl23007/nova-http.git"
  },
  "bin": {
    "create-nova-http": "dist/cli/create-nova.js",
    "nova-http": "dist/cli/nova.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "require": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./core": {
      "types": "./dist/src/core/index.d.ts",
      "require": "./dist/src/core/index.js",
      "default": "./dist/src/core/index.js"
    },
    "./middlewares": {
      "types": "./dist/src/middlewares/index.d.ts",
      "require": "./dist/src/middlewares/index.js",
      "default": "./dist/src/middlewares/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "postbuild": "node -e \"const fs=require('fs');fs.cpSync('cli/templates','dist/cli/templates',{recursive:true})\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "bench": "node scripts/benchmark/benchmark.js",
    "bench:stream": "node scripts/benchmark/benchmark-streaming.js",
    "bench:server": "node scripts/benchmark/benchmark-server.js",
    "bench:production": "pnpm --dir scripts/performance run start",
    "bench:production:stress": "pnpm --dir scripts/performance run stress",
    "bench:compare": "node scripts/benchmark/benchmark-compare.js",
    "bench:compare:extended": "node scripts/benchmark/benchmark-compare-extended.js",
    "bench:parser": "node scripts/benchmark/benchmark-parser-vs-llhttp.js",
    "bench:parser:native": "node scripts/benchmark/benchmark-parser-vs-node-native.js",
    "cli": "ts-node cli/nova.ts",
    "cli:init": "ts-node cli/create-nova.ts"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.11",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
